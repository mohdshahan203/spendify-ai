PORT=5000
NODE_ENV=production
DATABASE_URL="postgresql://postgres:password@ep-sample.us-east-2.aws.neon.tech/spendify?sslmode=require"
JWT_SECRET="your_spendify_jwt_secret_here"
JWT_REFRESH_SECRET="your_spendify_jwt_refresh_secret_here"
ML_SERVICE_URL="http://localhost:8000"

# Google Gemini GenAI Configuration (Official @google/genai SDK)
# Obtain your free API key at: https://aistudio.google.com/
# Add your key to environment variables (never commit your actual API key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Email Verification Service (Nodemailer SMTP / Transactional Provider)
# Leave blank for local development mode (OTPs logged to server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="SpendiFy Security" <no-reply@spendify.com>

