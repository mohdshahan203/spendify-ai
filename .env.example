# ======================================================================
# SpendiFy — Production Environment Variables Configuration
# Copy this file to .env for local use, or configure in Vercel Project Settings
# ======================================================================

# ─── DATABASE (Managed PostgreSQL) ──────────────────────────────────
# Required for persistent production storage (Neon, Supabase, Vercel Postgres, AWS RDS)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:password@ep-sample.us-east-2.aws.neon.tech/spendify?sslmode=require"

# ─── APPLICATION ENVIRONMENT ────────────────────────────────────────
NODE_ENV="production"
PORT=5000

# ─── AUTHENTICATION (JWT) ───────────────────────────────────────────
# Generate secure random strings (e.g. openssl rand -base64 32)
JWT_SECRET="generate_a_secure_random_jwt_secret_for_production"
JWT_REFRESH_SECRET="generate_another_secure_random_refresh_secret_for_production"

# ─── GOOGLE GEMINI AI (@google/genai SDK) ───────────────────────────
# Obtain a free API key at: https://aistudio.google.com/
# NEVER prefix with VITE_ to keep this server-side only
GEMINI_API_KEY="your_google_ai_studio_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# ─── PYTHON ML INFERENCE MICROSERVICE ────────────────────────────────
# Point to your dedicated ML inference service (hosted on Render, Railway, Fly.io, or AWS)
# Leave as http://localhost:8000 for local development
ML_SERVICE_URL="http://localhost:8000"

# ─── EMAIL VERIFICATION (SMTP / Transactional Email) ───────────────
# Configure your SMTP credentials for live 6-digit OTP email delivery
# Supports Gmail, Brevo, SendGrid, Amazon SES, or custom SMTP servers
# If left blank, runs in development mode (OTPs logged to server console)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_specific_password_here"
SMTP_FROM='"SpendiFy Security" <no-reply@spendify.com>'

# ─── FRONTEND URL (Optional for same-origin Vercel deployment) ───────
FRONTEND_URL="https://spendify-ai.vercel.app"
CLIENT_URL="https://spendify-ai.vercel.app"
