{
  "name": "spendify",
  "version": "1.0.0",
  "private": true,
  "description": "SpendiFy - AI-Powered Micro-Lending Platform",
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:ai": "cd ai-service && uvicorn app.main:app --reload --port 8000",
    "install:all": "cd client && npm install && cd ../server && npm install",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npx tsx prisma/seed.ts",
    "db:studio": "cd server && npx prisma studio",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build"
  },
  "keywords": ["fintech", "lending", "ai", "credit-scoring"],
  "license": "MIT"
}
